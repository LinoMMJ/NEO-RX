# Copia a .env.docker o ejecuta: powershell -File scripts/setup-docker.ps1
SECRET_KEY=REEMPLAZAR_CON_SECRETO_DJANGO
FERNET_KEY=REEMPLAZAR_CON_CLAVE_FERNET
POSTGRES_DB=neorx
POSTGRES_USER=neorx
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_POSTGRES

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
NEORX_HTTP_PORT=8080

NEORX_INPUT_SIZE=512
NEORX_TORCH_THREADS=4
NEORX_CNN_SOFT_LIMIT=180
NEORX_CNN_TIME_LIMIT=240

# Solo para la demostración local. En producción usa false y crea las cuentas
# desde un canal administrativo seguro.
NEORX_CREATE_DEMO_USERS=true
NEORX_ADMIN_PASSWORD=Admin123!
NEORX_MEDICO_PASSWORD=Medico123!
NEORX_RECEPCIONISTA_PASSWORD=Recepcionista123!
# ResNet-50 oficial de TorchXRayVision para la demostración: no requiere
# entrenamiento adicional y usa su resolución nativa de 512 px.
NEORX_MODEL_PATH=
NEORX_BASELINE_WEIGHTS=resnet50-res512-all
NEORX_DECISION_MODE=pretrained_effusion_categories
NEORX_BASELINE_MIN_SCORE=0.50
# En exposición se presenta una sola categoría predominante. Las puntuaciones
# siguen siendo experimentales y no equivalen a probabilidad diagnóstica.
NEORX_CATEGORY_MARGIN=0.00
NEORX_DEMO_ORIENTATION=false

# Para instalar un futuro checkpoint validado, usar por ejemplo:
# NEORX_MODEL_PATH=/app/diagnostico/models/neorx_effusion_categories_v2_resnet50.pt
# NEORX_DECISION_MODE=priority_category
