# Neo RX - Environment Variables
# Copia este archivo a .env y configura los valores
# Para producción: cp .env.example .env.production

# ─── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-generate-with:python-c-"from-django.core.management.utils-import-get_random_secret_key;-print(get_random_secret_key())"
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# ─── Encriptación (django-cryptography) ──────────────────────────────────────
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ─── Base de Datos ───────────────────────────────────────────────────────────
POSTGRES_DB=neorx
POSTGRES_USER=neorx
POSTGRES_PASSWORD=secure-password-here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-dominio.com

# ─── SSL/TLS ─────────────────────────────────────────────────────────────────
# Para Let's Encrypt, coloca certificados en ./ssl/
# SSL_CERT_PATH=./ssl/fullchain.pem
# SSL_KEY_PATH=./ssl/privkey.pem

# ─── Modelo IA ───────────────────────────────────────────────────────────────
# Ruta al checkpoint fine-tuned (opcional, si no existe usa baseline torchxrayvision)
NEORX_MODEL_PATH=/app/diagnostico/models/finetuned_resnet50_nih.pt

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATELIMIT_ENABLE=True
RATELIMIT_RATE=100/h