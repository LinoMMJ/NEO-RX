# Neo RX - Environment Variables
# Copia este archivo a .env y configura los valores
# Para producción: cp .env.example .env.production

# ─── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here-generate-with:python-c-"from-django.core.management.utils-import-get_random_secret_key;-print(get_random_secret_key())"
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio.com

# ─── Encriptación (django-cryptography) ──────────────────────────────────────
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ─── Base de Datos ───────────────────────────────────────────────────────────
POSTGRES_DB=neorx
POSTGRES_USER=neorx
POSTGRES_PASSWORD=secure-password-here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-dominio.com

# ─── SSL/TLS ─────────────────────────────────────────────────────────────────
# Para Let's Encrypt, coloca certificados en ./ssl/
# SSL_CERT_PATH=./ssl/fullchain.pem
# SSL_KEY_PATH=./ssl/privkey.pem

# ─── Modelo IA ───────────────────────────────────────────────────────────────
# Dejar vacío para usar temporalmente la DenseNet-121 preentrenada y rápida.
NEORX_MODEL_PATH=
NEORX_DECISION_THRESHOLDS_JSON=
NEORX_ENABLE_THRESHOLD_DECISIONS=false
NEORX_BASELINE_WEIGHTS=densenet121-res224-all
NEORX_INFERENCE_MODE=celery
NEORX_DECISION_MODE=pretrained_effusion_categories
NEORX_BASELINE_MIN_SCORE=0.50
NEORX_CATEGORY_MARGIN=0.10
# Para validación reproducible usa 512; 224 reduce la latencia en CPU local.
NEORX_INPUT_SIZE=512
NEORX_TORCH_THREADS=4
# Ajustar con validación local del equipo; 50 evita rechazar placas válidas
# de bajo contraste sin desactivar el control de desenfoque severo.
NEORX_BLUR_THRESHOLD=50

# Despliegue del checkpoint de cinco salidas evaluado por NeoRX:
# NEORX_MODEL_PATH=/app/diagnostico/models/neorx_effusion_categories_resnet50.pt
# NEORX_DECISION_MODE=priority_category
# NEORX_DECISION_THRESHOLDS_JSON={"Effusion":0.1676508635,"CategoryTumoral":0.2112646401,"CategoryPleural":0.1613885313,"CategoryInfectious":0.1314414889,"CategoryInterstitial":0.2572275996}
# NEORX_ENABLE_THRESHOLD_DECISIONS=true

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATELIMIT_ENABLE=True
RATELIMIT_RATE=100/h

# ─── Gmail SMTP para recuperación de contraseña ──────────────────────────────
# Activa verificación en dos pasos y usa una contraseña de aplicación de Google.
# No escribas aquí la contraseña normal de tu cuenta de Gmail.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_cuenta@gmail.com
EMAIL_HOST_PASSWORD=contraseña_de_aplicacion_de_16_caracteres
DEFAULT_FROM_EMAIL=tu_cuenta@gmail.com
PASSWORD_RESET_CODE_MINUTES=15
