# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# PostgreSQL
DB_NAME=neorx
DB_USER=postgres
DB_PASSWORD=<configurar-localmente>
DB_HOST=localhost
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Cifrado: generar localmente una clave válida; no subir .env
FERNET_KEY=<generar-localmente>
# Correo de desarrollo: mensajes en memoria, sin entrega externa
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend

# Gmail optional: configure locally; never commit credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FRONTEND_URL=http://localhost:5173
# DEFAULT_FROM_EMAIL must match the authorized SMTP sender.
