# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# PostgreSQL
DB_NAME=neorx
DB_USER=postgres
DB_PASSWORD=<configurar-localmente>
DB_HOST=localhost
DB_PORT=5432

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Cifrado: generar localmente una clave válida; no subir .env
FERNET_KEY=<generar-localmente>
# Correo de desarrollo: mensajes en memoria, sin entrega externa
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend

# Gmail optional: configure locally; never commit credentials.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PASSWORD_RESET_CODE_MINUTES=15
FRONTEND_URL=http://localhost:5173
# DEFAULT_FROM_EMAIL must match the authorized SMTP sender.

# Modelo local y rendimiento. "thread" no requiere Redis/Celery.
# Para activar el modelo entrenado por NeoRX:
# NEORX_MODEL_PATH=/app/diagnostico/models/neorx_effusion_categories_resnet50.pt
NEORX_MODEL_PATH=
NEORX_DECISION_THRESHOLDS_JSON=
NEORX_ENABLE_THRESHOLD_DECISIONS=false
# Temporal CPU: DenseNet preentrenada a su resolucion nativa.
# Para volver a ResNet: resnet50-res512-all.
NEORX_BASELINE_WEIGHTS=densenet121-res224-all
NEORX_INFERENCE_MODE=thread
NEORX_DECISION_MODE=pretrained_effusion_categories
NEORX_BASELINE_MIN_SCORE=0.50
NEORX_CATEGORY_MARGIN=0.10
# Mantener la resolución de entrenamiento; cambiarla requiere revalidación.
NEORX_INPUT_SIZE=512
NEORX_TORCH_THREADS=4

# Punto operativo reproducible del checkpoint de cinco salidas:
# NEORX_MODEL_PATH=/app/diagnostico/models/neorx_effusion_categories_resnet50.pt
# NEORX_DECISION_MODE=priority_category
# NEORX_DECISION_THRESHOLDS_JSON={"Effusion":0.1676508635,"CategoryTumoral":0.2112646401,"CategoryPleural":0.1613885313,"CategoryInfectious":0.1314414889,"CategoryInterstitial":0.2572275996}
# NEORX_ENABLE_THRESHOLD_DECISIONS=true
