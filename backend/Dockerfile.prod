# Dockerfile.prod - Backend Production
# Multi-stage build para imagen ligera y segura

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Builder (instala dependencias y compila)
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dependencias del sistema para compilar
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libc-dev \
    && rm -rf /var/lib/apt/lists/*

# Instalar dependencias Python
COPY requirements.txt .
# La imagen de producción no usa GPU. Instalar las ruedas CPU de PyTorch evita
# descargar dependencias CUDA de varios GB durante cada construcción.
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --index-url https://download.pytorch.org/whl/cpu torch==2.12.0 torchvision==0.27.0 \
    && sed -E '/^(torch|torchvision)==/d' requirements.txt > /tmp/requirements.no-torch.txt \
    && /opt/venv/bin/pip install -r /tmp/requirements.no-torch.txt

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Runtime (imagen final ligera)
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Usuario no-root para seguridad
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Dependencias runtime mínimas
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

# Copiar dependencias instaladas desde builder
COPY --from=builder /opt/venv /opt/venv

# Copiar código de la aplicación
COPY --chown=appuser:appuser . .

# Crear directorios necesarios
RUN mkdir -p /app/logs /app/media /app/static /app/diagnostico/models \
    && chown -R appuser:appuser /app

# Cambiar a usuario no-root
USER appuser

# Exponer puerto
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health/', timeout=5).raise_for_status()" || exit 1

# Comando por defecto (sobrescrito en docker-compose)
CMD ["gunicorn", "neorx.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120"]
