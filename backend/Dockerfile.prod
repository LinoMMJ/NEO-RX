# Dockerfile.prod - Backend Production
# Multi-stage build para imagen ligera y segura

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Builder (instala dependencias y compila)
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Dependencias del sistema para compilar
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libc-dev \
    && rm -rf /var/lib/apt/lists/*

# Instalar dependencias Python
COPY requirements.txt .
RUN pip install --user -r requirements.txt

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Runtime (imagen final ligera)
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/root/.local/bin:$PATH"

WORKDIR /app

# Usuario no-root para seguridad
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Dependencias runtime mínimas
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

# Copiar dependencias instaladas desde builder
COPY --from=builder /root/.local /root/.local

# Copiar código de la aplicación
COPY --chown=appuser:appuser . .

# Crear directorios necesarios
RUN mkdir -p /app/logs /app/media /app/static /app/diagnostico/models \
    && chown -R appuser:appuser /app

# Cambiar a usuario no-root
USER appuser

# Exponer puerto
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/api/token/', timeout=5)" || exit 1

# Comando por defecto (sobrescrito en docker-compose)
CMD ["gunicorn", "neorx.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120"]